#!/usr/bin/env python3
"""i3status wrapper that appends a git-sync indicator block."""

import json
import os
import subprocess
import sys
import threading

home = os.path.expanduser("~")
env = {**os.environ, "I3STATUS_OUTPUT_FORMAT": "i3bar"}

i3status = subprocess.Popen(
    ["stdbuf", "-oL", "/usr/bin/i3status", "-c", f"{home}/.config/i3status/config"],
    stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
    text=True, env=env,
)

TIMER_MENU = f"{home}/github/scripts/scripts/rofi/rofi-timer-menu.sh"


def click_listener():
    """Read i3bar click events from stdin; open timer menu on timer block click."""
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            evt = json.loads(line)
        except json.JSONDecodeError:
            continue
        if evt.get("name") == "timer" and evt.get("button") == 1:
            subprocess.Popen(
                ["bash", TIMER_MENU],
                stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )


threading.Thread(target=click_listener, daemon=True).start()

last_gsync = None
header_done = False
data_started = False

for line in i3status.stdout:
    line = line.rstrip("\n")

    if not header_done:
        header_done = True
        print('{"version":1,"click_events":true}', flush=True)
        continue

    if line == "[":
        print(line, flush=True)
        continue

    rest = line
    if line.startswith(","):
        rest = line[1:]

    try:
        blocks = json.loads(rest)
    except json.JSONDecodeError:
        print(line, flush=True)
        continue

    try:
        gsync = subprocess.run(
            [sys.executable, "-u", f"{home}/.local/bin/gsync-indicator"],
            capture_output=True, text=True, timeout=10,
        )
        if gsync.returncode == 0 and gsync.stdout.strip():
            try:
                last_gsync = json.loads(gsync.stdout.strip())
            except json.JSONDecodeError:
                pass
    except Exception:
        subprocess.run(
            ["notify-send", "-u", "low", "gsync-indicator", "timed out, retrying in 30s"],
            capture_output=True, timeout=3,
        )

    try:
        timer = subprocess.run(
            [sys.executable, "-u", f"{home}/.local/bin/timer-indicator"],
            capture_output=True, text=True, timeout=5,
        )
        if timer.returncode == 0 and timer.stdout.strip():
            try:
                blocks.append(json.loads(timer.stdout.strip()))
            except json.JSONDecodeError:
                pass
    except Exception:
        pass

    if last_gsync:
        blocks.append(last_gsync)

    prefix = "," if data_started else ""
    data_started = True
    print(prefix + json.dumps(blocks), flush=True)

i3status.wait()
