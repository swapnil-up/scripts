#!/usr/bin/env python3
"""Output a single i3bar block showing the nearest active timer.

Mirrors gsync-indicator: i3status-wrapper calls this each cycle and appends
the block. The block carries name="timer" so i3bar click events on it can be
routed to the rofi menu by the wrapper.
"""

import json
import os
import socket
import subprocess
import sys

SOCKET_NAME = "timer-daemon.sock"

RED = "#BF616A"
YELLOW = "#EBCB8B"
CYAN = "#88C0D0"
DIM = "#4C566A"


def socket_path():
    runtime = os.environ.get("XDG_RUNTIME_DIR")
    if runtime:
        return os.path.join(runtime, SOCKET_NAME)
    return f"/tmp/{SOCKET_NAME}-{os.getuid()}"


def query():
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.connect(socket_path())
        s.sendall(b'{"cmd":"list"}\n')
        buf = b""
        while True:
            chunk = s.recv(65536)
            if not chunk:
                break
            buf += chunk
        s.close()
        return json.loads(buf.decode())
    except (OSError, ValueError):
        return None


def fmt(seconds):
    h, rem = divmod(seconds, 3600)
    m, s = divmod(rem, 60)
    if h:
        return f"{h}:{m:02d}:{s:02d}"
    return f"{m:02d}:{s:02d}"


def main():
    data = query()
    timers = (data or {}).get("timers", [])
    active = [t for t in timers if t["remaining"] > 0]
    if not active:
        block = {
            "name": "timer",
            "full_text": "Timer",
            "short_text": "Timer",
            "color": DIM,
        }
    else:
        soonest = min(active, key=lambda t: t["remaining"])
        label = f" ({soonest['label']})" if soonest.get("label") else ""
        extra = f" +{len(active) - 1}" if len(active) > 1 else ""
        text = f"Timer {fmt(soonest['remaining'])}{label}{extra}"
        color = RED if soonest["remaining"] < 60 else (
            YELLOW if soonest["remaining"] < 300 else CYAN
        )
        block = {
            "name": "timer",
            "full_text": text,
            "short_text": text,
            "color": color,
        }
    print(json.dumps(block), flush=True)


if __name__ == "__main__":
    main()
