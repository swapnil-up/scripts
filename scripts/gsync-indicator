#!/usr/bin/env python3
"""Output a single i3status block showing git sync status of ~/github repos."""

import json
import subprocess
import sys
import os
import time

GITHUB_DIR = os.path.expanduser("~/github")
CHECK_INTERVAL = 30  # seconds between full checks
DEADLINE = 8  # hard cap for a full scan (wrapper kills us at 10s)
CACHE_FILE = f"/tmp/gsync-indicator-{os.getuid()}.json"

RED = "#BF616A"
GREEN = "#A3BE8C"
YELLOW = "#EBCB8B"
CYAN = "#88C0D0"


def check_repos(deadline):
    result = {"dirty": 0, "behind": 0, "ahead": 0, "total": 0, "errors": 0}

    def run_git(args, cwd):
        # Never let a single git call outlive the overall scan budget.
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise TimeoutError("gsync scan deadline reached")
        return subprocess.run(
            args, capture_output=True, text=True, cwd=cwd,
            timeout=min(5, remaining),
        )

    for entry in os.listdir(GITHUB_DIR):
        repo_dir = os.path.join(GITHUB_DIR, entry)
        git_dir = os.path.join(repo_dir, ".git")
        if not os.path.isdir(git_dir):
            continue

        remote_url = run_git(
            ["git", "remote", "get-url", "origin"], repo_dir
        ).stdout.strip() or ""
        if "github.com" not in remote_url or "/swapnil-up/" not in remote_url:
            continue

        result["total"] += 1

        status = run_git(
            ["git", "status", "--porcelain", "-b"], repo_dir
        ).stdout

        for line in status.splitlines():
            if line.startswith("##"):
                if "behind" in line:
                    result["behind"] += 1
                if "ahead" in line:
                    result["ahead"] += 1
            elif line.strip() and not line.startswith("##"):
                result["dirty"] += 1

    return result


def get_cached_or_fresh():
    now = time.time()
    cached = None
    try:
        with open(CACHE_FILE) as f:
            data = json.load(f)
        cached = data.get("result")
        if now - data.get("ts", 0) < CHECK_INTERVAL:
            return cached
    except (FileNotFoundError, json.JSONDecodeError, KeyError):
        pass

    try:
        result = check_repos(time.monotonic() + DEADLINE)
    except Exception:
        # On any failure (timeout, git error), prefer a stale value over "?".
        return cached

    with open(CACHE_FILE, "w") as f:
        json.dump({"ts": now, "result": result}, f)
    return result


def format_block(result):
    if result["total"] == 0:
        return {"name": "gsync", "markup": "none", "full_text": "no repos", "color": RED}

    parts = []
    colors = []

    if result["behind"] > 0:
        parts.append(f"↓{result['behind']}")
        colors.append(RED)
    if result["ahead"] > 0:
        parts.append(f"↑{result['ahead']}")
        colors.append(RED)
    if result["dirty"] > 0:
        parts.append(f"*{result['dirty']}")
        colors.append(YELLOW)

    if not parts:
        color = GREEN
        text = f"✓{result['total']}"
    else:
        color = colors[0] if colors else GREEN
        text = " ".join(parts)

    return {"name": "gsync", "markup": "none", "full_text": text, "color": color}


if __name__ == "__main__":
    result = get_cached_or_fresh()
    if result is None:
        block = {"name": "gsync", "markup": "none", "full_text": "?", "color": RED}
    else:
        block = format_block(result)
    print(json.dumps(block))
